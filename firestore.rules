rules_version = '2';
// DevSocio Firestore security rules (PRD §7.2).
// Signed-in users can read the public app; writes are scoped to the owner.
// Privileged operations check a Firebase Auth custom claim (`admin == true`)
// set via the Admin SDK — never the email, which is set by the user at sign-up.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid
    }
    // Custom-claim check. Set the claim from a trusted server context:
    //   admin.auth().setCustomUserClaims(uid, { admin: true })
    // The client cannot set this; the only way to become admin is for a
    // server-side action (cloud function or admin script) to grant the claim.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true
    }
    function isOwner() {
      // Hard-coded owner UID — checked at write time. Treat the owner's
      // account like any other admin but never demote or ban.
      return signedIn() && request.auth.uid == 'MQfcNaP1wwfe7v9ZOxwLtsbuRqn2'
    }
    // A user the admin has banned cannot create new content (get returns null if doc not found).
    function isBanned() {
      return signedIn()
        && !isAdmin()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true
    }
    // The owner account can never be banned or stripped of verified/moderator
    // — even by an admin write. Owner UID is baked into rules.
    function protectsOwner(uid) {
      return !(uid == 'MQfcNaP1wwfe7v9ZOxwLtsbuRqn2'
        && (request.resource.data.banned == true
            || request.resource.data.verified == false
            || request.resource.data.moderator == false))
    }

    // ---- Users & their private subcollections ----
    match /users/{uid} {
      allow read: if signedIn();
      // Profile create: field whitelist + length caps. Prevents new users
      // from setting credits, verified, moderator, founder on themselves.
      allow create: if isUser(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'email', 'photoURL', 'avatar', 'bio',
          'techStack', 'links', 'projects', 'role', 'createdAt', 'updatedAt',
          'lastLoginAt', 'fcmToken', 'credits', 'verified', 'moderator', 'founder',
          'banned', 'topDev', 'premiumTheme', 'followersCount', 'followingCount',
          'postsCount', 'onboardingDone', 'provider', 'referredBy', 'referralPaid',
          'streakDays', 'lastStreakAt', 'lastDailyAt', 'loginStreak', 'longestStreak',
          'devLevel', 'openToCollab', 'lookingForCofounder'
        ])
        && request.resource.data.uid == uid
        && !request.resource.data.keys().hasAny(['moderator'])
        && request.resource.data.credits <= 100
        && request.resource.data.verified == false
        && request.resource.data.founder == false
        && request.resource.data.topDev == false
        && request.resource.data.premiumTheme == null
        && request.resource.data.banned == false
        && !request.resource.data.diff(request.resource.data).affectedKeys().hasAny(['admin']);
      // Updates: owner may edit their profile, but cannot set privilege flags
      // (credits, verified, founder, banned, moderator). Counters and follower
      // count are bumped by client writes (decrement-by-1 enforcement below).
      allow update: if (
        isUser(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'credits', 'verified', 'founder', 'banned', 'moderator', 'topDev', 'premiumTheme', 'admin'
        ])
        && // follower counter may only be bumped by 1 per write
        (!('followersCount' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.followersCount == resource.data.followersCount + 1)
      ) || (
        // any signed-in user can decrement followersCount (unfollow) by 1
        signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
        && request.resource.data.followersCount == resource.data.followersCount - 1
      ) || (
        // admin can do anything, but never on the owner
        isAdmin() && !isOwner()
      )
        && protectsOwner(uid)
        && // Prevent a user from claiming the admin claim via a token copy trick
           !('admin' in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isAdmin() && !isOwner();

      // Bookmarks and follow edges belong to the user.
      match /saves/{postId} {
        allow read, write: if isUser(uid);
      }
      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if isUser(uid);
      }
      // Notifications: the owner reads/updates. Any authenticated user may
      // create a notification for their own actions (actorUid must match the
      // caller, preventing spoofed like/comment/follow notifications). The
      // admin (server) may also create via Cloud Functions / Admin SDK.
      match /notifications/{notifId} {
        allow read, update, delete: if isUser(uid);
        allow create: if isAdmin() || (
          signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.type in ['like', 'follow', 'comment', 'collab', 'mention']
          && request.resource.data.text.size() < 300
        );
      }
      // Credit transaction log — owner can read; only Admin SDK (server) can
      // create. The client never writes a log entry directly.
      match /credits_log/{logId} {
        allow read: if isUser(uid);
        allow create: if isAdmin();
        allow update, delete: if false;
      }
    }

    // ---- Posts, their likes and comments ----
    match /posts/{postId} {
      allow read: if signedIn();
      // Post create: author must equal the caller and content has a length cap.
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && !isBanned()
        && request.resource.data.content.size() < 5000
        && request.resource.data.type.size() < 32;
      // Update: author can edit, admin can edit, anyone can bump counters
      // (likes / commentsCount) by exactly +1 or -1 per write.
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentsCount'])
          && (request.resource.data.likes == resource.data.likes + 1
              || request.resource.data.likes == resource.data.likes - 1)
          && (request.resource.data.commentsCount == resource.data.commentsCount + 1
              || request.resource.data.commentsCount == resource.data.commentsCount - 1)
        )
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

      match /likes/{uid} {
        allow read: if signedIn();
        // Liking your own post is allowed client-side but a no-op (server logic).
        allow create, delete: if isUser(uid);
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && !isBanned()
          && request.resource.data.text.size() < 2000;
        // likesCount may be bumped by exactly +1 or -1; author/admin can edit.
        allow update: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || isAdmin()
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
            && (request.resource.data.likesCount == resource.data.likesCount + 1
                || request.resource.data.likesCount == resource.data.likesCount - 1)
          )
        );
        allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

        match /likes/{uid} {
          allow read: if signedIn();
          allow create, delete: if isUser(uid);
        }
      }
    }

    // collectionGroup query over all "likes" (which posts a user liked).
    match /{path=**}/likes/{uid} {
      allow read: if signedIn();
    }

    // collectionGroup query over all "following" (to find followers of a user).
    match /{path=**}/following/{targetUid} {
      allow read: if signedIn();
    }

    // ---- Ideas board ----
    match /ideas/{ideaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && !isBanned()
        && request.resource.data.title.size() < 120
        && request.resource.data.body.size() < 4000;
      // Invest: invested counter may be bumped by exactly +50 (the cost of an
      // investment). Author edits other fields. Admin edits anything.
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid
        || isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invested', 'investors'])
          && request.resource.data.invested == resource.data.invested + 50
        )
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- Stories (24h) ----
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && !isBanned();
      // Author/admin can edit; anyone can append a reaction or viewer entry.
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid
        || isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'viewers'])
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ---- Reports & moderation ----
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason.size() < 500
        && request.resource.data.targetId.size() < 200;
      allow read, update, delete: if isAdmin();
    }

    // ---- Error capture (Admin Copilot) ----
    // Any signed-in client may log a crash; only the admin can read/resolve.
    match /errors/{errorId} {
      allow create: if signedIn()
        && request.resource.data.message.size() < 4000
        && request.resource.data.source.size() < 64;
      allow read, update, delete: if isAdmin();
    }

    // ---- Monitoring digest (written by the cron via Admin SDK) ----
    match /admin_digests/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- Conversations ----
    match /conversations/{cid} {
      // Read: caller must be a member (orcid == null for non-existent doc).
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      // Create: caller must be in the new doc's members. The new members list
      // is limited to 2 (1:1 chat) to prevent mass-membership spam.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 2
        && request.resource.data.members.size() >= 2;
      // Update: caller must be in BOTH the old and new members list. Prevents
      // a malicious member from adding themselves to a stranger's chat.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == resource.data.members.size();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          !exists(/databases/$(database)/documents/conversations/$(cid))
          || request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members
        );
        allow create: if signedIn()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text.size() < 4000
          && (
            !exists(/databases/$(database)/documents/conversations/$(cid))
            || request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.members
          );
        // Allow update only for "deleted" flag flips; allow delete for own messages.
        allow update: if signedIn() && (
          resource.data.from == request.auth.uid
          || isAdmin()
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted']);
        allow delete: if isAdmin() || (signedIn() && resource.data.from == request.auth.uid);
      }
    }
  }
}
